{{- $enabledLanguages := where hugo.Sites "Language.Disabled" false -}}
{{- $enabledLanguageCodes := slice -}}
{{- range $enabledLanguages }}
  {{- $enabledLanguageCodes = $enabledLanguageCodes | append .Language.Lang }}
{{- end }}
{{- /*
  Regular pages are listed unless they are hidden (`hidden: true`), opted out
  through Hugo's `sitemap.disable` front matter, or are the generated search
  page, which only renders the search layout. Explicitly noindexed pages are
  excluded as well.
*/ -}}
{{- $regularPages := slice -}}
{{- range .Site.RegularPages }}
  {{- if and (in $enabledLanguageCodes .Language.Lang) (ne .Params.hidden true) (ne .Params.noindex true) (ne .Type "search") (not .Sitemap.Disable) }}
    {{- $regularPages = $regularPages | append . }}
  {{- end }}
{{- end }}
{{- /*
  The home page is listed even on a portfolio without posts. Other list pages
  (sections, taxonomies, terms) need at least one listed regular page. Their
  lastmod is the newest lastmod among those pages, so generated utility pages
  cannot give them a stale date.
*/ -}}
{{- $entries := slice -}}
{{- range where .Site.Pages "IsPage" false }}
  {{- if and (in $enabledLanguageCodes .Language.Lang) (ne .Params.hidden true) (ne .Params.noindex true) (not .Sitemap.Disable) }}
    {{- $members := slice -}}
    {{- if eq .Kind "taxonomy" }}
      {{- range .Pages }}
        {{- $members = $members | append .Pages }}
      {{- end }}
    {{- else if eq .Kind "term" }}
      {{- $members = .Pages }}
    {{- else }}
      {{- $members = .RegularPagesRecursive }}
    {{- end }}
    {{- $members = $members | intersect $regularPages }}
    {{- if or .IsHome $members }}
      {{- $lastmod := .Lastmod }}
      {{- if $members }}
        {{- $lastmod = (index (sort $members "Lastmod" "desc") 0).Lastmod }}
      {{- else if .IsHome }}
        {{- /* A generated search page's fixed date is not a portfolio update. */ -}}
        {{- $lastmod = time.AsTime "0001-01-01T00:00:00Z" }}
        {{- with .Params.lastmod | default .Params.date }}
          {{- $lastmod = time.AsTime . }}
        {{- end }}
      {{- end }}
      {{- $entries = $entries | append (dict "page" . "lastmod" $lastmod) }}
    {{- end }}
  {{- end }}
{{- end }}
{{- range $regularPages }}
  {{- $entries = $entries | append (dict "page" . "lastmod" .Lastmod) }}
{{- end }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- range $entries }}
  {{- $page := .page }}
  <url>
    <loc>{{ $page.Permalink }}</loc>
    {{- if not .lastmod.IsZero }}
    <lastmod>{{ .lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
    {{- with $page.Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge $page.Sitemap.Priority 0.0 }}
    <priority>{{ $page.Sitemap.Priority }}</priority>
    {{- end }}
    {{- if $page.IsTranslated }}
      {{- range $page.Translations }}
        {{- if and (in $enabledLanguageCodes .Language.Lang) (ne .Params.hidden true) (ne .Params.noindex true) (not .Sitemap.Disable) }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Locale | default .Language.Lang }}" href="{{ .Permalink }}" />
        {{- end }}
      {{- end }}
    {{- end }}
  </url>
{{- end }}
</urlset>
