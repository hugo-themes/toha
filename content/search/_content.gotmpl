{{/* Generate one search page for every enabled language. This avoids shipping
language-suffixed content files that collide when the language is not enabled. */}}
{{ .EnableAllLanguages }}

{{ $content := dict
  "mediaType" "text/markdown"
  "value" "This generated page exists solely to render the search layout."
}}
{{/* Give the page the site description, so meta tags that fall back to the
page summary do not expose the placeholder content above. */}}
{{ $description := site.Params.description }}
{{ with (index hugo.Data .Site.Language.Lang).site }}
  {{ with .description }}{{ $description = . }}{{ end }}
{{ end }}
{{ $dates := dict "date" (time.AsTime "2010-06-08T08:06:25+06:00") }}
{{ $sitemap := dict "priority" 0.1 }}
{{ $page := dict
  "content" $content
  "dates" $dates
  "description" $description
  "kind" "page"
  "layout" "search"
  "path" "."
  "sitemap" $sitemap
  "title" (i18n "search")
  "translationKey" "search"
  "type" "search"
}}
{{ .AddPage $page }}
